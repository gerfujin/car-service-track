# Reference for the VITE_API_BASE_URL values used across the committed env files:
#   .env              fallback default (used when no mode-specific file applies)
#   .env.development   used by `npm run dev` (Vite mode "development")
#   .env.production     used by `npm run build` (Vite mode "production"); overridden
#                      at Docker build time by the VITE_API_BASE_URL build arg
#
# For a value specific to your machine that you don't want committed, create
# .env.local or .env.<mode>.local (already git-ignored) instead of editing the
# committed files above.
VITE_API_BASE_URL=http://localhost:5065
