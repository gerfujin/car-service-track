# Production API base URL - set to the public URL where the ASP.NET backend is deployed.
# This project has no live deployment right now, so this is a placeholder, not a
# working endpoint — replace it if you deploy this yourself.
# When using Docker Compose (see docker-compose.yml), VITE_API_BASE_URL is passed as a
# build arg and overrides this file's value; see .env.example for the local default.
VITE_API_BASE_URL=https://api.yourdomain.example