# Copy to .env (git-ignored) to override the docker-compose.yml local defaults.
# None of these are required — `docker compose up --build` works with no .env
# file present at all, using the defaults baked into docker-compose.yml.

# Frontend build-time API base URL, baked into the JS bundle. Must match the
# host/port the backend is actually reachable on from your browser.
VITE_API_BASE_URL=http://localhost:99

# Origin the backend's CORS policy allows (must match where the frontend is served from).
FRONTEND_ORIGIN=http://localhost:98

# PostgreSQL password used by both the db and backend services.
POSTGRES_PASSWORD=postgres

# JWT signing key. Generate a real one with `openssl rand -base64 64` if this
# stack will ever hold data you care about; the checked-in default in
# docker-compose.yml is a disposable local-only placeholder.
JWT_KEY=
