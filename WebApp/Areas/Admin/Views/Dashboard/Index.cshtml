@model WebApp.Areas.Admin.ViewModels.DashboardViewModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>📊 Dashboard</h2>
    <small class="text-muted">CarServiceTrack Admin</small>
</div>

<!-- Stats Row -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card stat-card primary shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="text-muted small">Total Vehicles</div>
                        <div class="h3 fw-bold">@Model.TotalVehicles</div>
                    </div>
                    <div class="fs-1 text-primary opacity-50">🚗</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card warning shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="text-muted small">Service Orders</div>
                        <div class="h3 fw-bold">@Model.TotalServiceOrders</div>
                    </div>
                    <div class="fs-1 text-warning opacity-50">📋</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card success shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="text-muted small">Total Revenue</div>
                        <div class="h3 fw-bold">€@Model.TotalRevenue.ToString("N2")</div>
                    </div>
                    <div class="fs-1 text-success opacity-50">💰</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card danger shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="text-muted small">Clients</div>
                        <div class="h3 fw-bold">@Model.TotalClients</div>
                    </div>
                    <div class="fs-1 text-danger opacity-50">👥</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Order Status Row -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <div class="text-warning fs-2">⏳</div>
                <div class="h4">@Model.PendingOrders</div>
                <div class="text-muted">Pending Orders</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <div class="text-primary fs-2">🔧</div>
                <div class="h4">@Model.InProgressOrders</div>
                <div class="text-muted">In Progress</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body text-center">
                <div class="text-success fs-2">✅</div>
                <div class="h4">@Model.CompletedOrders</div>
                <div class="text-muted">Completed</div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Links -->
<div class="row g-3">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header">Quick Actions</div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-area="Admin" asp-controller="ServiceOrders" asp-action="Index" class="btn btn-outline-primary">
                        📋 Manage Service Orders
                    </a>
                    <a asp-area="Admin" asp-controller="Workshops" asp-action="Create" class="btn btn-outline-secondary">
                        🏭 Add Workshop
                    </a>
                    <a asp-area="Admin" asp-controller="Mechanics" asp-action="Create" class="btn btn-outline-secondary">
                        👨‍🔧 Add Mechanic
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header">System Info</div>
            <div class="card-body">
                <table class="table table-sm">
                    <tr><td>Workshops</td><td><strong>@Model.TotalWorkshops</strong></td></tr>
                    <tr><td>Mechanics</td><td><strong>@Model.TotalMechanics</strong></td></tr>
                    <tr><td>Registered Clients</td><td><strong>@Model.TotalClients</strong></td></tr>
                </table>
            </div>
        </div>
    </div>
</div>
