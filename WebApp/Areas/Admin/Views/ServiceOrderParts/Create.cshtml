@model WebApp.Areas.Admin.ViewModels.ServiceOrderPartAdminViewModel
@{ ViewData["Title"] = "Add Order Part"; }

<h2 class="mb-3">Add Spare Part to Order</h2>
<form asp-action="Create" method="post" class="card card-body shadow-sm">
    <div class="mb-3">
        <label asp-for="ServiceOrderId" class="form-label"></label>
        <select asp-for="ServiceOrderId" asp-items="Model.ServiceOrderOptions" class="form-select"></select>
    </div>
    <div class="mb-3">
        <label asp-for="SparePartId" class="form-label"></label>
        <select asp-for="SparePartId" asp-items="Model.SparePartOptions" class="form-select"></select>
    </div>
    <div class="mb-3">
        <label asp-for="Quantity" class="form-label"></label>
        <input asp-for="Quantity" class="form-control" type="number" min="1" />
    </div>
    <div class="mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" type="number" min="0" step="0.01" />
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" asp-route-serviceOrderId="@Model.ServiceOrderId" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

