@model WebApp.Areas.Admin.ViewModels.MechanicViewModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>🗑️ Delete Mechanic</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">← Back to List</a>
</div>

<div class="card border-danger shadow-sm" style="max-width: 500px;">
    <div class="card-header bg-danger text-white">
        <strong>Confirm Deletion</strong>
    </div>
    <div class="card-body">
        <p>Are you sure you want to delete this mechanic?</p>
        <dl class="row">
            <dt class="col-sm-4">Name</dt>
            <dd class="col-sm-8">@Model.FullName</dd>
            <dt class="col-sm-4">Specialization</dt>
            <dd class="col-sm-8">@(Model.Specialization ?? "—")</dd>
            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@(Model.Email ?? "—")</dd>
        </dl>
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Yes, Delete</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
