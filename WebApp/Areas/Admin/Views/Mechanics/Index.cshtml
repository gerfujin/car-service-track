@model Workshops.Presentation.Areas.Admin.ViewModels.MechanicListViewModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>👨‍🔧 Mechanics</h2>
    <a asp-action="Create" class="btn btn-primary">+ Add Mechanic</a>
</div>

@if (!Model.Mechanics.Any())
{
    <div class="alert alert-info">No mechanics found. <a asp-action="Create">Add the first mechanic.</a></div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Specialization</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Mechanics)
                    {
                        <tr>
                            <td><strong>@m.FullName</strong></td>
                            <td>@(m.Specialization ?? "—")</td>
                            <td>@(m.Phone ?? "—")</td>
                            <td>@(m.Email ?? "—")</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@m.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
