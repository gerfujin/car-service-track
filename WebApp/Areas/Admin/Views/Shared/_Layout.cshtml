@using Microsoft.Extensions.Localization
@inject IStringLocalizer<App.Resources.Views.CarService> Localizer
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@((Model as AdminPageViewModelBase)?.PageTitle ?? "Admin") - CarServiceTrack Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .sidebar { min-height: 100vh; background: #212529; }
        .sidebar .nav-link { color: #adb5bd; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { color: #fff; background: rgba(255,255,255,0.1); border-radius: 4px; }
        .sidebar .nav-link i { margin-right: 8px; }
        .main-content { background: #f8f9fa; min-height: 100vh; }
        .stat-card { border-left: 4px solid; }
        .stat-card.primary { border-color: #0d6efd; }
        .stat-card.success { border-color: #198754; }
        .stat-card.warning { border-color: #ffc107; }
        .stat-card.danger { border-color: #dc3545; }
    </style>
</head>
<body>
<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <nav class="col-md-2 d-none d-md-block sidebar py-3">
            <div class="text-white mb-4 px-3">
                <h5>🔧 CarServiceTrack</h5>
                <small class="text-muted">@Localizer["AdminPanel"]</small>
            </div>
            <ul class="nav flex-column px-2">
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        📊 @Localizer["AdminDashboard"]
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="ServiceOrders" asp-action="Index">
                        📋 @Localizer["AdminServiceOrders"]
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Workshops" asp-action="Index">
                        🏭 @Localizer["AdminWorkshops"]
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Mechanics" asp-action="Index">
                        👨‍🔧 @Localizer["AdminMechanics"]
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Services" asp-action="Index">
                        🔩 @Localizer["AdminServices"]
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="SpareParts" asp-action="Index">
                        🔧 @Localizer["AdminSpareParts"]
                    </a>
                </li>
                <hr class="border-secondary" />
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                        🏠 @Localizer["BackToSite"]
                    </a>
                </li>
                <li class="nav-item">
                    <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                        <button type="submit" class="nav-link btn btn-link text-start w-100">
                            🚪 @Localizer["Logout"]
                        </button>
                    </form>
                </li>
            </ul>
        </nav>

        <!-- Main content -->
        <main class="col-md-10 ms-sm-auto main-content px-4 py-3">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
