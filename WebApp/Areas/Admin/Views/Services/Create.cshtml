@model WebApp.Areas.Admin.ViewModels.ServiceAdminViewModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>🔩 Add Service</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">← Back to List</a>
</div>

<div class="card shadow-sm" style="max-width: 600px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Oil Change" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Service description..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="BasePrice" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">€</span>
                    <input asp-for="BasePrice" class="form-control" type="number" step="0.01" min="0" />
                </div>
                <span asp-validation-for="BasePrice" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EstimatedTimeMinutes" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="EstimatedTimeMinutes" class="form-control" type="number" min="0" />
                    <span class="input-group-text">min</span>
                </div>
                <span asp-validation-for="EstimatedTimeMinutes" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Service</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
