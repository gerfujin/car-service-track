@model WebApp.Areas.Mechanic.ViewModels.MechanicUpdateStatusViewModel
@{
    ViewData["Title"] = "Update Order Status";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">🔄 Update Order Status</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-3">
                    <dt class="col-sm-4">Vehicle</dt>
                    <dd class="col-sm-8">@Model.VehicleDisplay</dd>
                    <dt class="col-sm-4">Workshop</dt>
                    <dd class="col-sm-8">@Model.WorkshopName</dd>
                    @if (Model.Description != null)
                    {
                        <dt class="col-sm-4">Description</dt>
                        <dd class="col-sm-8">@Model.Description</dd>
                    }
                    <dt class="col-sm-4">Current Status</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-secondary">@Model.CurrentStatus</span>
                    </dd>
                </dl>

                <form asp-action="UpdateStatus" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CurrentStatus" />
                    <input type="hidden" asp-for="VehicleDisplay" />
                    <input type="hidden" asp-for="WorkshopName" />
                    <input type="hidden" asp-for="Description" />

                    <div class="mb-3">
                        <label asp-for="NewStatus" class="form-label fw-bold">New Status</label>
                        <select asp-for="NewStatus" class="form-select"
                                asp-items="Html.GetEnumSelectList<App.Domain.Enums.ServiceOrderStatus>()">
                        </select>
                        <span asp-validation-for="NewStatus" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label">Notes (optional)</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"
                                  placeholder="Describe what was done or why the status changed..."></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">✅ Update Status</button>
                        <a asp-area="Mechanic" asp-controller="Orders" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
