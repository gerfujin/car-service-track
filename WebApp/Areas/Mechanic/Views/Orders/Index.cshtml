@model Orders.Presentation.Areas.Mechanic.ViewModels.MechanicOrderListViewModel
@{
    ViewData["Title"] = "Service Orders";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>📋 Service Orders</h2>
    <span class="badge bg-secondary">Read + Status Update</span>
</div>

@if (!Model.Orders.Any())
{
    <div class="alert alert-info">No service orders found.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Vehicle</th>
                        <th>Workshop</th>
                        <th>Mechanic</th>
                        <th>Status</th>
                        <th>Order Date</th>
                        <th>Total</th>
                        <th>Payment</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td>@order.VehicleDisplay</td>
                            <td>@order.WorkshopName</td>
                            <td>@(order.MechanicName ?? "—")</td>
                            <td>
                                @{
                                    var badgeClass = order.Status switch
                                    {
                                        Orders.Domain.Enums.ServiceOrderStatus.Pending => "bg-secondary",
                                        Orders.Domain.Enums.ServiceOrderStatus.InProgress => "bg-primary",
                                        Orders.Domain.Enums.ServiceOrderStatus.Completed => "bg-success",
                                        Orders.Domain.Enums.ServiceOrderStatus.Cancelled => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @badgeClass">@order.Status</span>
                            </td>
                            <td>@order.OrderDate.ToString("dd.MM.yyyy")</td>
                            <td>€@order.TotalAmount.ToString("F2")</td>
                            <td>
                                @if (order.HasPayment)
                                {
                                    <span class="badge bg-success">Paid</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (order.Status != Orders.Domain.Enums.ServiceOrderStatus.Completed &&
                                     order.Status != Orders.Domain.Enums.ServiceOrderStatus.Cancelled)
                                {
                                    <a asp-area="Mechanic" asp-controller="Orders" asp-action="UpdateStatus"
                                       asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">
                                        🔄 Update Status
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

