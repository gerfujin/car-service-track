@model Users.Presentation.ViewModels.Client.VehicleClientViewModel
@{
    ViewData["Title"] = "Vehicle Details";
    var isReadOnly = ViewBag.IsReadOnly == true;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>🚗 Vehicle Details</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">← Back</a>
</div>

<div class="card shadow-sm" style="max-width: 600px;">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Make / Model</dt>
            <dd class="col-sm-8">@Model.Year @Model.Make @Model.Model</dd>
            <dt class="col-sm-4">License Plate</dt>
            <dd class="col-sm-8"><span class="badge bg-secondary">@Model.LicensePlate</span></dd>
            @if (Model.Vin != null)
            {
                <dt class="col-sm-4">VIN</dt>
                <dd class="col-sm-8">@Model.Vin</dd>
            }
            @if (Model.Color != null)
            {
                <dt class="col-sm-4">Color</dt>
                <dd class="col-sm-8">@Model.Color</dd>
            }
            @if (Model.Mileage.HasValue)
            {
                <dt class="col-sm-4">Mileage</dt>
                <dd class="col-sm-8">@Model.Mileage.Value.ToString("N0") km</dd>
            }
            <dt class="col-sm-4">Service Orders</dt>
            <dd class="col-sm-8">@Model.ServiceOrderCount</dd>
        </dl>
    </div>
    <div class="card-footer bg-transparent d-flex gap-2">
        @if (!isReadOnly)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Delete</a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>
