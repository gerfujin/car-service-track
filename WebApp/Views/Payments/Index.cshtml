@model Orders.Presentation.ViewModels.Client.PaymentClientListViewModel
@{
    ViewData["Title"] = "My Payments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>💰 My Payments</h2>
</div>

@if (!Model.Payments.Any())
{
    <div class="alert alert-info">
        <strong>No payments yet.</strong>
        <p class="mb-0">Your payment records will appear here once payments are processed for your service orders.</p>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Payment Method</th>
                        <th>Paid At</th>
                        <th>Created</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model.Payments)
                    {
                        <tr>
                            <td><strong>€@payment.Amount.ToString("F2")</strong></td>
                            <td>
                                @{
                                    var badgeClass = payment.Status switch
                                    {
                                        Orders.Domain.Enums.PaymentStatus.Pending => "bg-warning text-dark",
                                        Orders.Domain.Enums.PaymentStatus.Paid => "bg-success",
                                        Orders.Domain.Enums.PaymentStatus.Cancelled => "bg-danger",
                                        Orders.Domain.Enums.PaymentStatus.Refunded => "bg-info",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @badgeClass">@payment.Status</span>
                            </td>
                            <td>@(payment.PaymentMethod ?? "—")</td>
                            <td>@(payment.PaidAt?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                            <td>@payment.CreatedAt.ToString("dd.MM.yyyy")</td>
                            <td class="text-muted">@(payment.Notes ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

