@model WebApp.ViewModels.ListItemDeleteViewModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>ListItem</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">Item Description</dt>
        <dd class = "col-sm-10">@Model.ItemDescription</dd>
        <dt class = "col-sm-2">Summary</dt>
        <dd class = "col-sm-10">@Model.Summary</dd>
        <dt class = "col-sm-2">Is Done</dt>
        <dd class = "col-sm-10">@Model.IsDone</dd>
        <dt class = "col-sm-2">User</dt>
        <dd class = "col-sm-10">@Model.AppUserEmail</dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
