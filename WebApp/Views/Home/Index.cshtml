@{
    ViewData["Title"] = "CarServiceTrack - Car Service Transparency System";
}

<!-- Hero Section -->
<div class="py-5 text-center bg-dark text-white rounded-3 mb-5" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%) !important;">
    <div class="py-4">
        <div class="fs-1 mb-3">🔧</div>
        <h1 class="display-5 fw-bold">CarServiceTrack</h1>
        <p class="lead mb-4">Transparent car service management. Track your vehicle repairs, monitor progress, and manage payments — all in one place.</p>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Vehicles" asp-action="Index" class="btn btn-primary btn-lg me-2">My Vehicles</a>
            <a asp-controller="ServiceOrders" asp-action="Index" class="btn btn-outline-light btn-lg">My Orders</a>
        }
        else
        {
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary btn-lg me-2">Get Started</a>
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-light btn-lg">Sign In</a>
        }
    </div>
</div>

<!-- Features -->
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm text-center p-3">
            <div class="fs-1 mb-3">🚗</div>
            <h5>Vehicle Management</h5>
            <p class="text-muted">Add and manage all your vehicles in one place. Track make, model, mileage, and service history.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm text-center p-3">
            <div class="fs-1 mb-3">📋</div>
            <h5>Service Orders</h5>
            <p class="text-muted">Create service orders, track repair progress in real-time, and see exactly what work is being done.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm text-center p-3">
            <div class="fs-1 mb-3">💰</div>
            <h5>Payment Tracking</h5>
            <p class="text-muted">View itemized costs for services and spare parts. Track payment status transparently.</p>
        </div>
    </div>
</div>

<!-- How it works -->
<div class="bg-light rounded-3 p-4 mb-5">
    <h3 class="text-center mb-4">How It Works</h3>
    <div class="row g-3">
        <div class="col-md-3 text-center">
            <div class="badge bg-primary rounded-circle p-3 fs-5 mb-2">1</div>
            <h6>Register</h6>
            <p class="text-muted small">Create your account</p>
        </div>
        <div class="col-md-3 text-center">
            <div class="badge bg-primary rounded-circle p-3 fs-5 mb-2">2</div>
            <h6>Add Vehicle</h6>
            <p class="text-muted small">Register your car</p>
        </div>
        <div class="col-md-3 text-center">
            <div class="badge bg-primary rounded-circle p-3 fs-5 mb-2">3</div>
            <h6>Create Order</h6>
            <p class="text-muted small">Submit service request</p>
        </div>
        <div class="col-md-3 text-center">
            <div class="badge bg-primary rounded-circle p-3 fs-5 mb-2">4</div>
            <h6>Track Progress</h6>
            <p class="text-muted small">Monitor in real-time</p>
        </div>
    </div>
</div>
