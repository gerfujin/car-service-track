@using Microsoft.Extensions.Localization
@inject IStringLocalizer<App.Resources.Views.CarService> Localizer
@model WebApp.ViewModels.Client.ServiceOrderClientListViewModel
@{
    ViewData["Title"] = Localizer["Orders"];
    var canUpdateStatus = ViewBag.CanUpdateStatus == true;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>📋 @Localizer["Orders"]</h2>
</div>

@if (!Model.Orders.Any())
{
    <div class="alert alert-info">
        <strong>No service orders yet.</strong>
        <p class="mb-0">Service orders will appear here once they are created.</p>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Vehicle</th>
                        <th>@Localizer["Workshop"]</th>
                        <th>@Localizer["Mechanic"]</th>
                        <th>@Localizer["Status"]</th>
                        <th>@Localizer["OrderDate"]</th>
                        <th>@Localizer["TotalAmount"]</th>
                        <th>@Localizer["PaymentStatus"]</th>
                        @if (canUpdateStatus)
                        {
                            <th class="text-end">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td>@order.VehicleDisplay</td>
                            <td>@order.WorkshopName</td>
                            <td>@(order.MechanicName ?? "—")</td>
                            <td>
                                @{
                                    var badgeClass = order.Status switch
                                    {
                                        App.Domain.Enums.ServiceOrderStatus.Pending => "bg-secondary",
                                        App.Domain.Enums.ServiceOrderStatus.InProgress => "bg-primary",
                                        App.Domain.Enums.ServiceOrderStatus.Completed => "bg-success",
                                        App.Domain.Enums.ServiceOrderStatus.Cancelled => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @badgeClass">@order.Status</span>
                            </td>
                            <td>@order.OrderDate.ToString("dd.MM.yyyy")</td>
                            <td>€@order.TotalAmount.ToString("F2")</td>
                            <td>
                                @if (order.HasPayment)
                                {
                                    <span class="badge bg-success">Paid</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>
                            @if (canUpdateStatus)
                            {
                                <td class="text-end">
                                    @if (User.IsInRole("mechanic"))
                                    {
                                        <a asp-area="Mechanic" asp-controller="Orders" asp-action="UpdateStatus"
                                           asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">
                                            🔄 Update Status
                                        </a>
                                    }
                                    else if (User.IsInRole("admin"))
                                    {
                                        <a asp-area="Admin" asp-controller="ServiceOrders" asp-action="UpdateStatus"
                                           asp-route-id="@order.Id" class="btn btn-sm btn-outline-warning">
                                            🔄 Update Status
                                        </a>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
